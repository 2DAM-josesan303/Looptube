<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <!-- Miniatura del video -->
    <ImageView
        android:id="@+id/ivMiniaturaItem"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_placeholder"
        android:contentDescription="Miniatura" />

    <!-- Contenedor de título y canal -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvTituloItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre de la canción"
            android:textSize="16sp"
            android:textColor="#000"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tvCanalItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del canal"
            android:textSize="14sp"
            android:textColor="#666"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>

    <!-- Botón reproducir -->
    <ImageButton
        android:id="@+id/btnPlayItem"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@null"
        android:src="@drawable/ic_play"
        android:contentDescription="Reproducir"/>

    <!-- Botón eliminar -->
    <ImageButton
        android:id="@+id/btnDeleteItem"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="8dp"
        android:background="@null"
        android:src="@drawable/ic_delete"
        android:contentDescription="Eliminar"/>

</LinearLayout>